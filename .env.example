# Gemini API key (https://aistudio.google.com/apikey). In production inject via Secret Manager.
GEMINI_API_KEY=
# Model fallback chain used for vision diagnosis (tried left-to-right).
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash-lite

# Database: local SQLite file for dev/VM, or a Turso/libSQL URL in production.
DATABASE_URL=file:./data/math-sprout.db
# DATABASE_URL=libsql://math-sprout-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Image storage: leave GCS_BUCKET empty to store on local disk (file: DB) or in libSQL image_blobs (remote/serverless DB).
GCS_BUCKET=
# STORAGE_BACKEND=db

# Optional shared family passcode to keep strangers from burning your Gemini quota.
FAMILY_PASSCODE=
