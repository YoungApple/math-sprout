# Gemini API key (https://aistudio.google.com/apikey). In production inject via Secret Manager.
GEMINI_API_KEY=
# Model used for vision diagnosis. gemini-2.5-flash is fast/cheap; gemini-2.5-pro for deeper reasoning.
GEMINI_MODEL=gemini-2.5-flash

# Database: local SQLite file for dev, or a Turso/libSQL URL in production.
DATABASE_URL=file:./data/math-sprout.db
# DATABASE_URL=libsql://math-sprout-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Image storage: leave GCS_BUCKET empty to store under ./data/uploads (dev).
GCS_BUCKET=

# Optional shared family passcode to keep strangers from burning your Gemini quota.
FAMILY_PASSCODE=
